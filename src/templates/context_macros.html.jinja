{% from "macros.html.jinja" import icon %}

{% macro navigation_buttons() -%}
    {%- set links = paging(scroll.cursor, has_next=scroll.has_next) -%}
    <div id="navigation_buttons">
        {% if links.start -%}
            <a class="a_button" href="{{ links.start }}">{{ icon("angles-left") }}Start</a>
        {%- endif %}
        {% if links.previous -%}
            <a class="a_button" href="{{ links.previous }}">{{ icon("chevron-right", class="flip") }}Previous</a>
        {%- endif %}
        {% if links.next -%}
            <a class="a_button" href="{{ links.next }}">Next{{ icon("chevron-right") }}</a>
        {%- endif %}
    </div>
{%- endmacro %}
