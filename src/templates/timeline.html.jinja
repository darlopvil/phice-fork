{% extends "base.html.jinja" %}
{% from "macros.html.jinja" import icon, Post, expandable, photo %}
{% from "context_macros.html.jinja" import navigation_buttons with context %}

{% block head %}
    <link rel="stylesheet" href="{{ url_for('static', filename='timeline.css') }}" />
{% endblock head %}

{% block content %}
    <div class="timeline_cover">{{ photo(feed.cover_photo) if feed.cover_photo is not none }}</div>
    <div id="timeline">
        <section id="timeline_info" class="card">
            <div id="timeline_header">
                {{ photo(feed.profile_photo, cls="timeline_picture") if feed.profile_photo is not none }}
                <div>
                    <span class="profile_name">{{ feed.name }}</span>{{
                        icon("circle-check", class="profile_checkmark") if feed.verified
                    }}
                    <br />
                    <span id="timeline_stat">{{ feed.members + " Members" if feed.members }}{{
                        feed.followers + " Followers" if feed.followers
                    }}{{ " • " + feed.following + " Following" if feed.following }}{{
                        " • " + feed.likes + " Likes" if feed.likes
                    }}</span>
                </div>
            </div>
            <div id="timeline_intro">
                {{ expandable(feed.description, cls="timeline_description") if feed.description }}
                {% if feed.info %}
                    <hr />
                    {% for i in feed.info %}
                        <a {% if i.url %}href="{{ i.url }}"{% endif %}>
                            <div class="timeline_info_cards">
                                {%- if i.type in ("website", "other_account") -%}
                                    {{ icon("link") }}
                                {%- elif i.type in ("address", "hometown", "current_city") -%}
                                    {{ icon("location") }}
                                {%- elif i.type == "phone" -%}
                                    {{ icon("phone") }}
                                {%- elif i.type == "work" -%}
                                    {{ icon("briefcase") }}
                                {%- elif i.type == "education" -%}
                                    {{ icon("user-graduate") }}
                                {%- elif i.type == "business_hours" -%}
                                    {{ icon("clock") }}
                                {%- elif i.type == "profile_email" -%}
                                    {{ icon("email") }}
                                {%- else -%}
                                    {{ icon("circle-info") }}
                                {%- endif -%}
                                <span>{{ i.network ~ " · " if i.network }}{{ i.text }}</span>
                            </div>
                        </a>
                    {% endfor %}
                {% endif %}
            </div>
        </section>
        <section id="timeline_feed">
            {% if not feed.is_group -%}
                <nav class="profile_tabs">
                    {% for endpoint, label in (("profile.profile", "Posts"), ("profile.reels", "Reels"), ("profile.photos", "Photos"), ("profile.videos", "Videos"), ("profile.events", "Events")) -%}
                        <a href="{{ url_for(endpoint, username=feed.token) }}"><span
                            class="profile_tab{{ ' active' if request.endpoint == endpoint or (endpoint == 'profile.profile' and request.endpoint == 'profile.profile_php') }}"
                        >{{ label }}</span></a>
                    {%- endfor %}
                </nav>
            {%- endif %}
            {% block feed %}
            {% if not feed.is_group and not feed.is_private and not request.args.get("cursor") -%}
                <span class="message_card">Facebook leaves reels out of this timeline for logged-out visitors: they are in the
                    <a href="{{ url_for('profile.reels', username=feed.token) }}"><span class="message_link">Reels</span></a> tab.</span>
            {%- endif %}
            {% if feed.is_private %}
                <span class="card centered">{{ icon("lock") }} The content is private.</span>
            {% elif feed.posts %}
                {% for i in feed.posts %}
                    {{ Post(i, expanded=get_user_settings().expand) }}
                {% endfor %}
                {% if scroll.rate_limited %}
                    <span class="centered card">Couldn't fetch rest of posts rate-limited.</span>
                {% endif %}
                {{ navigation_buttons() }}
            {% else %}
                <span class="card centered">No posts.</span>
            {% endif %}
            {% endblock feed %}
        </section>
    </div>
{% endblock content %}
